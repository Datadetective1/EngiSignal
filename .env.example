# ─────────────────────────────────────────────────────────────────────────────
# EngiSignal environment configuration
#
# EngiSignal runs FULLY WITHOUT any of these variables. With no configuration
# it uses the local deterministic synthetic dataset and a demo session, which
# is the intended way to evaluate the product.
#
# Copy to .env.local and fill in only what you need.
# NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data backend ─────────────────────────────────────────────────────────────
# "mock"     — local deterministic synthetic dataset (default, no credentials)
# "supabase" — Postgres via Supabase; requires the Supabase variables below
ENGISIGNAL_DATA_PROVIDER=mock

# ── Supabase (only when ENGISIGNAL_DATA_PROVIDER=supabase) ───────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key — safe for the browser, protected by Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# There is deliberately NO service-role key here. Every database call the
# application makes runs as the signed-in user, so Row Level Security is the
# thing enforcing tenant isolation rather than an afterthought. Provisioning a
# key that bypasses RLS for code that never uses it only widens the blast
# radius of a leaked environment.

# ── AI ("Ask EngiSignal") ────────────────────────────────────────────────────
# Optional. Without a key, Ask EngiSignal answers from deterministic analytics
# only — it never fabricates numbers either way.
# Supported providers: "anthropic" | "openai" | "none"
ENGISIGNAL_AI_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model identifier for the selected provider
ENGISIGNAL_AI_MODEL=claude-sonnet-5

# ── Branding ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@engisignal.com
NEXT_PUBLIC_PILOT_EMAIL=pilot@engisignal.com
# Set once a legal entity is registered; falls back to "EngiSignal"
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# ── Upload limits ────────────────────────────────────────────────────────────
# A BLANK value is treated as absent and the default is used. Never set these
# to an empty string expecting "no limit" — see config/env.ts.
ENGISIGNAL_MAX_UPLOAD_BYTES=26214400
ENGISIGNAL_MAX_IMPORT_ROWS=500000

# ── The ingestion worker ────────────────────────────────────────────────────
#
# Large imports are written by a worker on the database's own schedule, after
# the uploading request has ended. It has no session to borrow, so it carries an
# identity of its own -- a Postgres role, not an API key.
#
# INGESTION_WORKER_DATABASE_URL is a connection string for the `ingestion_worker`
# role through Supabase's TRANSACTION pooler (port 6543). That role has EXECUTE
# on six job functions, USAGE on one schema, and no privilege over any table
# anywhere; it is a member of no other role, so it cannot SET ROLE to one.
#
# Deliberately NOT a JWT: any key able to sign a token can sign one that says
# `service_role`, so a signing secret's real authority is "everything" whatever
# role is written inside it. A role password's authority is exactly its grants.
#
# Server-side only. Never prefix this with NEXT_PUBLIC_.
INGESTION_WORKER_DATABASE_URL=

# Presented by pg_cron when it wakes the worker, and checked in constant time
# before the endpoint does anything. The same value is held in the database's
# Vault as `ingestion_worker_secret`. Without both, imports queue and never drain.
CRON_SECRET=
